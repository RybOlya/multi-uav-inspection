    {
      "datasource": {"type": "influxdb", "uid": "SwarmInfluxDB"},
      "description": "Linear speed magnitude sqrt(vx^2 + vy^2 + vz^2). Configured cruise speed is SIM_CRUISE_SPEED_MPS.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisLabel": "speed [m/s]",
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never"
          },
          "min": 0,
          "unit": "velms"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "id": 5,
      "options": {
        "legend": {"displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["lastNotNull", "max"]},
        "tooltip": {"mode": "multi", "sort": "none"}
      },
      "targets": [
        {
          "datasource": {"type": "influxdb", "uid": "SwarmInfluxDB"},
          "query": "import \"math\"\n\nfrom(bucket: \"telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"drone_state\")\n  |> filter(fn: (r) => r._field == \"vx\" or r._field == \"vy\" or r._field == \"vz\")\n  |> pivot(rowKey:[\"_time\",\"drone_id\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> map(fn: (r) => ({ _time: r._time, drone_id: r.drone_id, _value: math.sqrt(x: r.vx*r.vx + r.vy*r.vy + r.vz*r.vz) }))\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> group(columns: [\"drone_id\"])",
          "refId": "A"
        }
      ],
      "title": "Speed",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "influxdb", "uid": "SwarmInfluxDB"},
      "description": "Active trajectory progress: elapsed_s / total_s for each drone (latest sample).",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "max": 1,
          "min": 0,
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "blue", "value": null},
            {"color": "green", "value": 0.5},
            {"color": "orange", "value": 0.95}
          ]},
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 20},
      "id": 6,
      "options": {
        "displayMode": "gradient",
        "minVizHeight": 10,
        "minVizWidth": 0,
        "orientation": "horizontal",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "showUnfilled": true
      },
      "pluginVersion": "10.4.2",
      "targets": [
        {
          "datasource": {"type": "influxdb", "uid": "SwarmInfluxDB"},
          "query": "from(bucket: \"telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"drone_state\")\n  |> filter(fn: (r) => r._field == \"elapsed_s\" or r._field == \"total_s\")\n  |> last()\n  |> pivot(rowKey:[\"drone_id\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> map(fn: (r) => ({ drone_id: r.drone_id, _value: if r.total_s > 0.0 then (if r.elapsed_s / r.total_s > 1.0 then 1.0 else r.elapsed_s / r.total_s) else 0.0 }))",
          "refId": "A"
        }
      ],
      "title": "Trajectory progress",
      "type": "bargauge"
    },
    {
