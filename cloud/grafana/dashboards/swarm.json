    {
      "datasource": {"type": "influxdb", "uid": "SwarmInfluxDB"},
      "description": "Latest reported mode per drone (idle / takeoff / goto / scan / hover / land).",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [
            {"options": {"idle":     {"color": "blue",   "index": 0, "text": "idle"}},     "type": "value"},
            {"options": {"takeoff":  {"color": "purple", "index": 1, "text": "takeoff"}},  "type": "value"},
            {"options": {"goto":     {"color": "green",  "index": 2, "text": "goto"}},     "type": "value"},
            {"options": {"scan":     {"color": "orange", "index": 3, "text": "scan"}},     "type": "value"},
            {"options": {"hover":    {"color": "yellow", "index": 4, "text": "hover"}},    "type": "value"},
            {"options": {"land":     {"color": "red",    "index": 5, "text": "land"}},     "type": "value"}
          ],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 24, "x": 0, "y": 0},
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "value_and_name"
      },
      "pluginVersion": "10.4.2",
      "targets": [
        {
          "datasource": {"type": "influxdb", "uid": "SwarmInfluxDB"},
          "query": "from(bucket: \"telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"drone_state\")\n  |> filter(fn: (r) => r._field == \"x\")\n  |> last()\n  |> keep(columns: [\"drone_id\", \"mode\", \"_value\"])\n  |> map(fn: (r) => ({ _value: r.mode, drone_id: r.drone_id }))\n  |> group(columns: [\"drone_id\"])",
          "refId": "A"
        }
      ],
      "title": "Drone modes (live)",
      "type": "stat"
    },
    {
