# MQTT broker (Mosquitto from docker-compose.yml)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=swarm

# Number of drones spawned by isaac/swarm_app.py
SIM_NUM_DRONES=2

# Default cruise speed (m/s) used to size quintic point-to-point durations
# (Lynch & Park 2017 [26]). Operator commands may override per-message via
# the optional `cruise_speed_mps` field. Conservative indoor default.
SIM_CRUISE_SPEED_MPS=0.5

# Default takeoff altitude (m). Keep >= 3.0 to clear 2 m rack tops.
SIM_TAKEOFF_ALTITUDE_M=3.0
# Boustrophedon sweep spacing (m). Set equal to aisle width → one pass per aisle.
SIM_SCAN_SWEEP_SPACING_M=2.5
# Battery drain % per second. Default 0.05 → realistic (33 min to empty).
# Set to 2.0 for a relay demo that triggers handoff in ~20 s of flight.
SIM_BATTERY_DRAIN_RATE_PPS=0.05
# Battery % threshold at which relay_demo triggers a drone handoff.
SIM_BATTERY_RELAY_THRESHOLD_PCT=40.0

# Scene source: warehouse | usd
SIM_SCENE_STYLE=warehouse

# Pegasus SIMULATION_ENVIRONMENTS key when scene_style=warehouse.
# Common: "Full Warehouse", "Warehouse with Shelves", "Warehouse with Forklifts",
# "Hospital", "Office", "Default Environment".
SIM_PEGASUS_ENV_NAME=Full Warehouse

# When SIM_SCENE_STYLE=usd:
# SIM_USD_SCENE_PATH=/home/you/factory_hall.usd
